<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include database and preferences in user cloud backup -->
        <include domain="database" path="focus_os_database.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow secure device-to-device migration -->
        <include domain="database" path="focus_os_database.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

